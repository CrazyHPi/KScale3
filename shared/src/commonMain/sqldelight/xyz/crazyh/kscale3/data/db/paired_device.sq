CREATE TABLE paired_device (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    mac TEXT NOT NULL,
    ble_id TEXT NOT NULL,
    name TEXT NOT NULL,
    model TEXT,
    sn TEXT,
    weight_unit INTEGER,
    last_seen INTEGER NOT NULL
);

-- 单台秤：取最近一次保存的记录
get:
SELECT *
FROM paired_device
ORDER BY last_seen DESC
LIMIT 1;

insert:
INSERT INTO paired_device(mac, ble_id, name, model, sn, weight_unit, last_seen)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- 秤显示单位（WeightUnit.code；NULL = 尚未获得）。按 MAC 限定，避免设备换行后误写。
updateWeightUnit:
UPDATE paired_device
SET weight_unit = ?
WHERE mac = ?;

deleteAll:
DELETE FROM paired_device;
